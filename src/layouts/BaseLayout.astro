---
import '../styles/global.css';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import BottomBar from '@components/BottomBar.astro';
import { site } from '@config/site';
import { localeTag, ogLocale, defaultLang, type Lang } from '@i18n/config';
import { useTranslations } from '@i18n/utils';
import type { HreflangAlt } from '@lib/urls';
import { businessNode, personNode, websiteNode } from '@lib/schema';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  /** Cluster hreflang: rutas relativas por idioma. Si falta, no se emite. */
  alternates?: HreflangAlt[];
  /** Nodos JSON-LD adicionales (Service, FAQPage, BreadcrumbList…). */
  schema?: object[];
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  lang = defaultLang,
  alternates = [],
  schema = [],
  ogImage,
  noindex = false,
} = Astro.props;

const t = useTranslations(lang);
const siteUrl = Astro.site?.origin ?? 'https://constanzaacevedo.es';
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = new URL(ogImage ?? '/og/default.png', siteUrl).href;

const graph = [
  businessNode(siteUrl),
  personNode(siteUrl),
  websiteNode(siteUrl, lang),
  ...schema,
];
const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---

<!doctype html>
<html lang={localeTag[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- hreflang recíproco + x-default → ES (PLAN §7.2) -->
    {
      alternates.map((a) => (
        <link rel="alternate" hreflang={a.hreflang} href={new URL(a.href, siteUrl).href} />
      ))
    }
    {
      alternates.length > 0 && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(alternates.find((a) => a.lang === defaultLang)?.href ?? '/', siteUrl).href}
        />
      )
    }

    <!-- Open Graph / Twitter (PLAN §7.4) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="theme-color" content="#3f6446" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-3 focus:rounded-lg focus:bg-[var(--color-primary-700)] focus:px-4 focus:py-2 focus:text-white">
      {t('a11y.skip')}
    </a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <BottomBar lang={lang} />
  </body>
</html>
