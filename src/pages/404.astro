---
import BaseLayout from '@layouts/BaseLayout.astro';
import { routes } from '@i18n/config';

const lang = 'es' as const;
---

<BaseLayout title="Página no encontrada | Constanza Acevedo" description="La página que buscas no existe." lang={lang} noindex={true}>
  <div class="container-page flex min-h-[50vh] flex-col items-center justify-center py-20 text-center">
    <p class="font-[var(--font-display)] text-6xl font-semibold text-[var(--color-primary-600)]">404</p>
    <h1 class="mt-4 text-3xl">No encuentro esta página</h1>
    <p class="mt-3 max-w-md text-[var(--color-ink-soft)]">
      Puede que el enlace haya cambiado. Te dejo el camino de vuelta.
    </p>
    <div class="mt-6 flex flex-col gap-3 sm:flex-row">
      <a href={routes.home[lang]} class="rounded-full bg-[var(--color-accent-600)] px-6 py-3 font-bold text-white no-underline">Ir al inicio</a>
      <a href={routes.services[lang]} class="rounded-full border border-[var(--color-primary-300)] px-6 py-3 font-bold text-[var(--color-primary-700)] no-underline">Ver servicios</a>
    </div>
  </div>
</BaseLayout>
