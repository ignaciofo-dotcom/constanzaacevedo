---
import BaseLayout from '@layouts/BaseLayout.astro';
import MetricStrip from '@components/MetricStrip.astro';
import ServiceCard from '@components/ServiceCard.astro';
import TestimonialCard from '@components/TestimonialCard.astro';
import Faq from '@components/Faq.astro';
import CtaWhatsApp from '@components/CtaWhatsApp.astro';
import Icon from '@components/Icon.astro';
import { site } from '@config/site';
import { routes } from '@i18n/config';
import { useTranslations } from '@i18n/utils';
import { getServices, getTestimonials, getGlobalFaqs } from '@lib/content';
import { serviceUrl, whatsappUrl, hreflangForRoute } from '@lib/urls';
import { faqNode } from '@lib/schema';

const lang = 'es' as const;
const t = useTranslations(lang);

const services = await getServices(lang);
const featured = services.filter((s) => s.data.featuredOnHome);
const testimonials = await getTestimonials(lang);
const faqs = (await getGlobalFaqs(lang)).slice(0, 4);
const alternates = hreflangForRoute('home');

const childServices = services.filter((s) => s.data.audience === 'child');
const womanServices = services.filter((s) => s.data.audience === 'woman');

const title = 'Fisioterapia pediátrica y acupuntura para la mujer en Barcelona | Constanza Acevedo';
const description =
  'Fisioterapia pediátrica y respiratoria para tu bebé y acupuntura para tu salud, en Barcelona. Colegiada 18641, +15 años de experiencia. Escríbeme por WhatsApp.';
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  alternates={alternates}
  schema={[faqNode(faqs)]}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="container-page grid items-center gap-10 py-14 md:grid-cols-2 md:py-20">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full bg-[var(--color-primary-100)] px-3 py-1 text-xs font-bold text-[var(--color-primary-700)]">
          <Icon name="leaf" size={14} /> Col. {site.person.collegiateNumber} · +{site.metrics.yearsExperience} años · Barcelona
        </p>
        <h1 class="mt-4 text-4xl sm:text-5xl">
          Fisioterapia pediátrica y acupuntura para la mujer en Barcelona
        </h1>
        <p class="mt-4 max-w-lg text-lg text-[var(--color-ink-soft)]">
          Cuido el desarrollo y la respiración de tu bebé, y te acompaño a ti en tu salud —fertilidad,
          embarazo, ciclo y menopausia— desde la evidencia y la cercanía.
        </p>
        <div class="mt-7 flex flex-col gap-3 sm:flex-row">
          <a
            href={whatsappUrl(t('wa.default'))}
            data-analytics="wa-click"
            class="inline-flex items-center justify-center gap-2 rounded-full bg-[var(--color-accent-600)] px-6 py-3 font-bold text-white no-underline hover:bg-[var(--color-accent-700)]"
          >
            <Icon name="whatsapp" size={22} /> {t('cta.whatsapp')}
          </a>
          <a
            href={routes.services[lang]}
            class="inline-flex items-center justify-center gap-2 rounded-full border border-[var(--color-primary-300)] px-6 py-3 font-bold text-[var(--color-primary-700)] no-underline hover:bg-[var(--color-primary-50)]"
          >
            {t('cta.seeServices')}
          </a>
        </div>
      </div>
      <div class="relative">
        <div class="aspect-[4/5] w-full overflow-hidden rounded-[var(--radius-2xl)] border border-[var(--color-sand)] bg-[var(--color-sand)]">
          <!-- [INPUT ★: foto real de Coty en consulta] -->
          <div class="flex h-full w-full items-center justify-center text-center text-sm text-[var(--color-ink-muted)]">
            [INPUT] Foto real de Constanza en consulta (4:5)
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Doble camino -->
  <section class="container-page py-6">
    <div class="grid gap-5 md:grid-cols-2">
      <a
        href={serviceUrl(childServices[0]?.data.slug ?? '', lang)}
        class="group relative overflow-hidden rounded-[var(--radius-2xl)] border border-[var(--color-sand)] bg-[var(--color-primary-50)] p-8 no-underline"
      >
        <span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-[var(--color-primary-100)] text-[var(--color-primary-700)]">
          <Icon name="baby" size={26} />
        </span>
        <h2 class="mt-4 text-2xl text-[var(--color-primary-800)]">{t('label.forChild')}</h2>
        <p class="mt-2 text-[var(--color-ink-soft)]">
          Fisioterapia pediátrica y respiratoria, masaje infantil y visitas a domicilio.
        </p>
        <span class="mt-4 inline-flex items-center gap-1 font-bold text-[var(--color-primary-700)] group-hover:gap-2">
          {t('cta.seeMore')} <Icon name="chevron" size={16} />
        </span>
      </a>
      <a
        href={serviceUrl(womanServices[0]?.data.slug ?? '', lang)}
        class="group relative overflow-hidden rounded-[var(--radius-2xl)] border border-[var(--color-sand)] bg-[var(--color-accent-100)] p-8 no-underline"
      >
        <span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-[var(--color-accent-100)] text-[var(--color-accent-700)] ring-1 ring-[var(--color-accent-300)]">
          <Icon name="flower" size={26} />
        </span>
        <h2 class="mt-4 text-2xl text-[var(--color-accent-700)]">{t('label.forYou')}</h2>
        <p class="mt-2 text-[var(--color-ink-soft)]">
          Acupuntura para tu salud: fertilidad, embarazo, ciclo menstrual y menopausia.
        </p>
        <span class="mt-4 inline-flex items-center gap-1 font-bold text-[var(--color-accent-700)] group-hover:gap-2">
          {t('cta.seeMore')} <Icon name="chevron" size={16} />
        </span>
      </a>
    </div>
  </section>

  <div class="mt-10"><MetricStrip lang={lang} /></div>

  <!-- Servicios -->
  <section class="container-page py-14">
    <h2 class="text-3xl">Servicios</h2>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        featured.map((s) => (
          <ServiceCard
            href={serviceUrl(s.data.slug, lang)}
            title={s.data.title}
            summary={s.data.summary}
            icon={s.data.icon}
            audience={s.data.audience}
            lang={lang}
          />
        ))
      }
    </div>
  </section>

  <!-- Quién soy resumido -->
  <section class="bg-[var(--color-sand)]/40">
    <div class="container-page grid items-center gap-8 py-14 md:grid-cols-[2fr_3fr]">
      <div class="aspect-square overflow-hidden rounded-[var(--radius-2xl)] border border-[var(--color-sand)] bg-[var(--color-sand)]">
        <div class="flex h-full items-center justify-center text-center text-sm text-[var(--color-ink-muted)]">
          [INPUT] Foto de Constanza
        </div>
      </div>
      <div>
        <h2 class="text-3xl">Hola, soy Coty</h2>
        <p class="mt-4 text-[var(--color-ink-soft)]">
          Fisioterapeuta (2010) y acupuntora, colegiada 18641 del Col·legi de Fisioterapeutes de
          Catalunya, con más de 15 años de experiencia entre atención primaria, hospital y desarrollo
          infantil. Soy mamá de Esteban y Bastián, celíaca y con un hijo con alergia alimentaria: sé
          lo que es mirar la salud de tu familia desde la preocupación.
        </p>
        <a
          href={routes.about[lang]}
          class="mt-5 inline-flex items-center gap-1 font-bold text-[var(--color-accent-600)] no-underline hover:gap-2"
        >
          Conóceme mejor <Icon name="chevron" size={16} />
        </a>
      </div>
    </div>
  </section>

  <!-- Testimonios -->
  <section class="container-page py-14">
    <h2 class="text-3xl">Lo que dicen las familias y las pacientes</h2>
    <p class="mt-2 text-sm text-[var(--color-ink-muted)]">
      [INPUT] Reseñas reales de Google / Doctoralia (con permiso).
    </p>
    <div class="mt-8 grid gap-5 md:grid-cols-3">
      {testimonials.map((tst) => <TestimonialCard text={tst.text} author={tst.author} source={tst.source} />)}
    </div>
  </section>

  <!-- Dónde -->
  <section class="container-page pb-6">
    <div class="grid gap-5 md:grid-cols-2">
      <div class="rounded-[var(--radius-2xl)] border border-[var(--color-sand)] bg-[var(--color-surface)] p-6">
        <h2 class="flex items-center gap-2 text-xl"><Icon name="pin" size={22} class="text-[var(--color-primary-600)]" /> Centro Llevadonas</h2>
        <p class="mt-2 text-[var(--color-ink-soft)]">
          C. de la Independència 371, Baixos · 08026 Barcelona<br />Camp de l'Arpa · Sant Martí
        </p>
        <a href={site.nap.mapUrl} target="_blank" rel="noopener" data-analytics="map-click" class="mt-3 inline-block font-bold text-[var(--color-accent-600)] no-underline">
          {t('label.howToArrive')} →
        </a>
      </div>
      <div class="rounded-[var(--radius-2xl)] border border-[var(--color-sand)] bg-[var(--color-surface)] p-6">
        <h2 class="flex items-center gap-2 text-xl"><Icon name="home" size={22} class="text-[var(--color-primary-600)]" /> {t('label.homeVisits')}</h2>
        <p class="mt-2 text-[var(--color-ink-soft)]">
          Llevo la fisioterapia a tu casa cuando salir con el bebé se complica: recién nacidos,
          bronquiolitis o familias sin desplazamiento fácil.
        </p>
      </div>
    </div>
  </section>

  <div class="container-page">
    <Faq items={faqs} lang={lang} />
  </div>

  <div class="container-page">
    <CtaWhatsApp message={t('wa.default')} lang={lang} />
  </div>
</BaseLayout>
