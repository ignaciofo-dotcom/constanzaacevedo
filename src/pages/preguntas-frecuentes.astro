---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Faq from '@components/Faq.astro';
import CtaWhatsApp from '@components/CtaWhatsApp.astro';
import { routes } from '@i18n/config';
import { useTranslations } from '@i18n/utils';
import { getGlobalFaqs } from '@lib/content';
import { hreflangForRoute } from '@lib/urls';
import { faqNode, breadcrumbNode } from '@lib/schema';

const lang = 'es' as const;
const t = useTranslations(lang);
const faqs = await getGlobalFaqs(lang);
const alternates = hreflangForRoute('faq');
const siteUrl = Astro.site?.origin ?? 'https://constanzaacevedo.es';
const crumbs = [
  { name: t('breadcrumb.home'), href: routes.home[lang] },
  { name: t('nav.faq'), href: routes.faq[lang] },
];
---

<BaseLayout
  title="Preguntas frecuentes | Constanza Acevedo · Barcelona"
  description="Dudas frecuentes sobre fisioterapia pediátrica, respiratoria y acupuntura en Barcelona: primera visita, sesiones, derivación, tarifas y cómo pedir cita."
  lang={lang}
  alternates={alternates}
  schema={[
    faqNode(faqs),
    breadcrumbNode(crumbs.map((c) => ({ name: c.name, url: new URL(c.href, siteUrl).href }))),
  ]}
>
  <Breadcrumbs items={crumbs} />
  <div class="container-page py-8">
    <h1 class="text-4xl">Preguntas frecuentes</h1>
    <p class="mt-3 max-w-2xl text-lg text-[var(--color-ink-soft)]">
      Las dudas que más me llegan. Si no encuentras la tuya, escríbeme por WhatsApp.
    </p>
    <Faq items={faqs} lang={lang} title=" " />
    <CtaWhatsApp message={t('wa.default')} lang={lang} />
  </div>
</BaseLayout>
