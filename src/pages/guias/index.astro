---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Icon from '@components/Icon.astro';
import { routes } from '@i18n/config';
import { useTranslations } from '@i18n/utils';
import { getGuides } from '@lib/content';
import { guideUrl, hreflangForRoute } from '@lib/urls';
import { breadcrumbNode } from '@lib/schema';

const lang = 'es' as const;
const t = useTranslations(lang);
const guides = await getGuides(lang);
const alternates = hreflangForRoute('guides');
const siteUrl = Astro.site?.origin ?? 'https://constanzaacevedo.es';
const crumbs = [
  { name: t('breadcrumb.home'), href: routes.home[lang] },
  { name: t('nav.guides'), href: routes.guides[lang] },
];
const df = new Intl.DateTimeFormat('es-ES', { year: 'numeric', month: 'long' });
---

<BaseLayout
  title="Guías de fisioterapia infantil y salud de la mujer | C. Acevedo"
  description="Guías prácticas y revisadas sobre bronquiolitis, plagiocefalia, hitos motores, acupuntura y fertilidad. Información clara para familias y mujeres en Barcelona."
  lang={lang}
  alternates={alternates}
  schema={[breadcrumbNode(crumbs.map((c) => ({ name: c.name, url: new URL(c.href, siteUrl).href })))]}
>
  <Breadcrumbs items={crumbs} />
  <div class="container-page py-8">
    <h1 class="text-4xl">Guías</h1>
    <p class="mt-3 max-w-2xl text-lg text-[var(--color-ink-soft)]">
      Información clara y revisada para acompañarte. Escritas por mí, actualizadas y con fuentes.
    </p>

    <div class="mt-8 grid gap-5 sm:grid-cols-2">
      {
        guides.map((g) => (
          <a
            href={guideUrl(g.data.slug, lang)}
            class="group flex flex-col rounded-[var(--radius-2xl)] border border-[var(--color-sand)] bg-[var(--color-surface)] p-6 no-underline shadow-[var(--shadow-soft)] transition-transform hover:-translate-y-1 motion-reduce:hover:translate-y-0"
          >
            <div class="flex items-center gap-2 text-xs font-bold">
              <span
                class:list={[
                  'rounded-full px-2 py-0.5',
                  g.data.audience === 'woman'
                    ? 'bg-[var(--color-accent-100)] text-[var(--color-accent-700)]'
                    : 'bg-[var(--color-primary-100)] text-[var(--color-primary-700)]',
                ]}
              >
                {g.data.audience === 'woman' ? t('label.forYou') : t('label.forChild')}
              </span>
              {g.data.seasonal && <span class="text-[var(--color-ink-muted)]">· Estacional</span>}
            </div>
            <h2 class="mt-3 text-xl group-hover:text-[var(--color-primary-700)]">{g.data.title}</h2>
            <p class="mt-2 flex-1 text-sm text-[var(--color-ink-soft)]">{g.data.summary}</p>
            <p class="mt-4 flex items-center justify-between text-xs text-[var(--color-ink-muted)]">
              <span>Actualizada: {df.format(g.data.updatedDate)}</span>
              <Icon name="chevron" size={16} class="text-[var(--color-accent-600)]" />
            </p>
          </a>
        ))
      }
    </div>

    <p class="mt-8 text-sm text-[var(--color-ink-muted)]">
      [INPUT] Guías pendientes de redactar (§6.9): tortícolis congénita, hitos motores 0–12 m,
      moxibustión bebé de nalgas, acupuntura y fertilidad, acupuntura en la menopausia.
    </p>
  </div>
</BaseLayout>
