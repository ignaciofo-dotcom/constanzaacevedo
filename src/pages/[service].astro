---
import { render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Faq from '@components/Faq.astro';
import CtaWhatsApp from '@components/CtaWhatsApp.astro';
import { routes } from '@i18n/config';
import { useTranslations } from '@i18n/utils';
import { getServices, serviceSlugMap } from '@lib/content';
import { serviceUrl, hreflangForPaths } from '@lib/urls';
import { serviceNode, faqNode, breadcrumbNode } from '@lib/schema';

const lang = 'es' as const;

export async function getStaticPaths() {
  const services = await getServices('es');
  return services.map((entry) => ({
    params: { service: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(entry);

const slugMap = await serviceSlugMap(entry.data.serviceKey);
const alternates = hreflangForPaths(slugMap);
const siteUrl = Astro.site?.origin ?? 'https://constanzaacevedo.es';
const pageUrl = new URL(serviceUrl(entry.data.slug, lang), siteUrl).href;

const crumbs = [
  { name: t('breadcrumb.home'), href: routes.home[lang] },
  { name: t('nav.services'), href: routes.services[lang] },
  { name: entry.data.title, href: serviceUrl(entry.data.slug, lang) },
];

const schema = [
  serviceNode({ name: entry.data.title, description: entry.data.metaDescription, url: pageUrl }),
  breadcrumbNode(crumbs.map((c) => ({ name: c.name, url: new URL(c.href, siteUrl).href }))),
  ...(entry.data.faqs.length ? [faqNode(entry.data.faqs)] : []),
];
---

<BaseLayout
  title={entry.data.metaTitle}
  description={entry.data.metaDescription}
  lang={lang}
  alternates={alternates}
  schema={schema}
  ogImage={`/og/servicios/${entry.data.slug}.png`}
>
  <Breadcrumbs items={crumbs} />

  <article class="container-page py-8">
    <header class="prose-content">
      <span
        class:list={[
          'inline-block rounded-full px-3 py-1 text-xs font-bold',
          entry.data.audience === 'woman'
            ? 'bg-[var(--color-accent-100)] text-[var(--color-accent-700)]'
            : 'bg-[var(--color-primary-100)] text-[var(--color-primary-700)]',
        ]}
      >
        {entry.data.audience === 'woman' ? t('label.forYou') : t('label.forChild')}
      </span>
      <h1 class="mt-3 text-4xl">{entry.data.title}</h1>
      <p class="mt-3 text-lg text-[var(--color-ink-soft)]">{entry.data.summary}</p>
    </header>

    <div class="prose-content mt-8">
      <Content />
    </div>

    <Faq items={entry.data.faqs} lang={lang} />

    <CtaWhatsApp
      message={entry.data.whatsappMessage}
      label={entry.data.ctaLabel ?? t('cta.whatsapp')}
      lang={lang}
    />
  </article>
</BaseLayout>
