---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import ServiceCard from '@components/ServiceCard.astro';
import CtaWhatsApp from '@components/CtaWhatsApp.astro';
import Icon from '@components/Icon.astro';
import { routes } from '@i18n/config';
import { useTranslations } from '@i18n/utils';
import { getServices } from '@lib/content';
import { serviceUrl, hreflangForRoute } from '@lib/urls';
import { breadcrumbNode } from '@lib/schema';

const lang = 'es' as const;
const t = useTranslations(lang);
const services = await getServices(lang);
const child = services.filter((s) => s.data.audience === 'child');
const woman = services.filter((s) => s.data.audience === 'woman');
const alternates = hreflangForRoute('services');
const siteUrl = Astro.site?.origin ?? 'https://constanzaacevedo.es';

const crumbs = [
  { name: t('breadcrumb.home'), href: routes.home[lang] },
  { name: t('nav.services'), href: routes.services[lang] },
];
// id de compatibilidad con anclas antiguas (PLAN §5): /servicios#fisiopediatrica
const anchorId: Record<string, string> = {
  'fisio-pediatrica': 'fisiopediatrica',
  'fisio-respiratoria': 'fisiorespiratoria',
  'acupuntura-mujer': 'acupuntura',
  'masaje-infantil': 'masajes',
  domicilios: 'domicilios',
};
---

<BaseLayout
  title="Servicios de fisioterapia infantil en Barcelona | C. Acevedo"
  description="Fisioterapia pediátrica y respiratoria para tu bebé en Barcelona: plagiocefalia, tortícolis, bronquiolitis, masaje infantil y domicilios. Y acupuntura para la mujer."
  lang={lang}
  alternates={alternates}
  schema={[breadcrumbNode(crumbs.map((c) => ({ name: c.name, url: new URL(c.href, siteUrl).href })))]}
>
  <Breadcrumbs items={crumbs} />

  <div class="container-page py-8">
    <h1 class="text-4xl">Servicios</h1>
    <p class="mt-3 max-w-2xl text-lg text-[var(--color-ink-soft)]">
      La fisioterapia pediátrica y respiratoria es el corazón de mi consulta. Y también hay un
      espacio para ti: la acupuntura de la mujer, como línea complementaria.
    </p>

    <!-- Para tu peque -->
    <section class="mt-12">
      <h2 class="section-title flex items-center gap-2 text-2xl">
        <Icon name="baby" size={26} class="text-[var(--color-primary-600)]" /> {t('label.forChild')}
      </h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          child.map((s) => (
            <ServiceCard
              id={anchorId[s.data.serviceKey]}
              href={serviceUrl(s.data.slug, lang)}
              title={s.data.title}
              summary={s.data.summary}
              icon={s.data.icon}
              audience="child"
              lang={lang}
            />
          ))
        }
      </div>
    </section>

    <!-- Para ti -->
    <section class="mt-14">
      <h2 class="section-title flex items-center gap-2 text-2xl text-[var(--color-accent-700)]">
        <Icon name="flower" size={26} class="text-[var(--color-accent-600)]" /> {t('label.forYou')} · Acupuntura de la mujer
      </h2>
      <p class="mt-2 max-w-2xl text-sm text-[var(--color-ink-soft)]">
        Salud menstrual, fertilidad y reproducción asistida, embarazo y menopausia — desde la MTC,
        siempre como complemento de tu seguimiento médico.
      </p>
      <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          woman.map((s) => (
            <ServiceCard
              id={anchorId[s.data.serviceKey]}
              href={serviceUrl(s.data.slug, lang)}
              title={s.data.title}
              summary={s.data.summary}
              icon={s.data.icon}
              audience="woman"
              lang={lang}
            />
          ))
        }
      </div>
    </section>

    <CtaWhatsApp message={t('wa.default')} lang={lang} />
  </div>
</BaseLayout>
