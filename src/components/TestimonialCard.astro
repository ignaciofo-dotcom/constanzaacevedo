---
import Icon from './Icon.astro';

interface Props {
  text: string;
  author: string;
  source?: string;
}
const { text, author, source } = Astro.props;
---

<figure class="flex h-full flex-col rounded-[var(--radius-2xl)] border border-[var(--color-sand)] bg-[var(--color-surface)] p-6 shadow-[var(--shadow-soft)]">
  <div class="flex gap-0.5 text-[var(--color-accent-400)]" aria-hidden="true">
    {[0, 1, 2, 3, 4].map(() => <Icon name="star" size={18} class="fill-current" />)}
  </div>
  <blockquote class="mt-3 flex-1 text-[var(--color-ink-soft)]">“{text}”</blockquote>
  <figcaption class="mt-4 text-sm font-semibold text-[var(--color-ink)]">
    {author}
    {source && <span class="ml-1 font-normal text-[var(--color-ink-muted)]">· {source}</span>}
  </figcaption>
</figure>
