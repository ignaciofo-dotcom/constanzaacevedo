---
import Icon from './Icon.astro';
import { site } from '@config/site';
import { social } from '@config/social';
import { defaultLang, routes, type Lang } from '@i18n/config';
import { useTranslations } from '@i18n/utils';
import { telUrl, emailUrl } from '@lib/urls';
import { getCollection } from 'astro:content';

interface Props {
  lang?: Lang;
}
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

const locations = (await getCollection('locations')).map((l) => l.data);
const clinic = locations.find((l) => l.type === 'clinic');
const activeSocial = Object.values(social).filter((s) => s.url);
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-[var(--color-sand)] bg-[var(--color-sand)]/50 pb-24 lg:pb-10">
  <div class="container-page grid gap-10 py-12 md:grid-cols-3">
    <div>
      <div class="flex items-center gap-2 font-[var(--font-display)] text-lg font-semibold text-[var(--color-primary-700)]">
        <Icon name="leaf" size={24} />
        <span>{site.brand}</span>
      </div>
      <p class="mt-3 max-w-xs text-sm text-[var(--color-ink-soft)]">{t('footer.tagline')}</p>
      <p class="mt-3 text-sm font-semibold text-[var(--color-primary-700)]">
        {t('label.collegiate')} {site.person.collegiateNumber} · CFC
      </p>
    </div>

    <div class="text-sm">
      <h2 class="font-[var(--font-display)] text-base font-semibold">{t('label.where')}</h2>
      {
        clinic && (
          <address class="mt-2 not-italic text-[var(--color-ink-soft)]">
            <div class="flex items-start gap-2">
              <Icon name="pin" size={18} class="mt-0.5 shrink-0 text-[var(--color-primary-600)]" />
              <span>
                {clinic.name}
                <br />
                {clinic.street}
                <br />
                {clinic.postalCode} {clinic.locality}
              </span>
            </div>
          </address>
        )
      }
      <p class="mt-3 flex items-center gap-2 text-[var(--color-ink-soft)]">
        <Icon name="clock" size={18} class="text-[var(--color-primary-600)]" />
        <span>Lu 16:00–20:30 · Vi 10:00–13:00</span>
      </p>
      <p class="mt-2">
        <a href={telUrl()} class="flex items-center gap-2 text-[var(--color-ink-soft)] no-underline hover:text-[var(--color-primary-700)]">
          <Icon name="phone" size={18} class="text-[var(--color-primary-600)]" />
          {site.contact.phone.display}
        </a>
      </p>
      <p class="mt-2">
        <a href={emailUrl()} class="flex items-center gap-2 text-[var(--color-ink-soft)] no-underline hover:text-[var(--color-primary-700)]">
          <Icon name="mail" size={18} class="text-[var(--color-primary-600)]" />
          {site.contact.email}
        </a>
      </p>
    </div>

    <div class="text-sm">
      <h2 class="font-[var(--font-display)] text-base font-semibold">{t('nav.services')}</h2>
      <ul class="mt-2 space-y-1.5">
        <li><a href={routes.services[lang]} class="text-[var(--color-ink-soft)] no-underline hover:text-[var(--color-primary-700)]">{t('nav.services')}</a></li>
        <li><a href={routes.guides[lang]} class="text-[var(--color-ink-soft)] no-underline hover:text-[var(--color-primary-700)]">{t('nav.guides')}</a></li>
        <li><a href={routes.about[lang]} class="text-[var(--color-ink-soft)] no-underline hover:text-[var(--color-primary-700)]">{t('nav.about')}</a></li>
        <li><a href={routes.faq[lang]} class="text-[var(--color-ink-soft)] no-underline hover:text-[var(--color-primary-700)]">{t('nav.faq')}</a></li>
        <li><a href={routes.book[lang]} class="text-[var(--color-ink-soft)] no-underline hover:text-[var(--color-primary-700)]">{t('nav.book')}</a></li>
      </ul>
      {
        activeSocial.length > 0 && (
          <div class="mt-4 flex gap-3">
            {activeSocial.map((s) => (
              <a href={s.url!} rel="me noopener" target="_blank" class="text-[var(--color-primary-700)] no-underline">
                {s.name}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </div>

  <div class="container-page flex flex-col gap-3 border-t border-[var(--color-sand)] py-5 text-xs text-[var(--color-ink-muted)] sm:flex-row sm:items-center sm:justify-between">
    <p>© {year} {site.nap.legalName}. {t('footer.rights')}</p>
    <nav class="flex flex-wrap gap-4" aria-label="Legal">
      <a href={routes.legal[lang]} class="text-[var(--color-ink-muted)] no-underline hover:text-[var(--color-primary-700)]">{t('footer.legal')}</a>
      <a href={routes.privacy[lang]} class="text-[var(--color-ink-muted)] no-underline hover:text-[var(--color-primary-700)]">{t('footer.privacy')}</a>
      <a href={routes.cookies[lang]} class="text-[var(--color-ink-muted)] no-underline hover:text-[var(--color-primary-700)]">{t('footer.cookies')}</a>
    </nav>
  </div>
</footer>
