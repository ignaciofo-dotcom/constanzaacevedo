---
import { defaultLang, type Lang } from '@i18n/config';
import { useTranslations } from '@i18n/utils';

/**
 * Acordeón FAQ con <details> nativo (sin JS, PLAN §4). El schema FAQPage lo
 * emite la página vía @lib/schema — este componente solo pinta la UI.
 */
interface Props {
  items: { q: string; a: string }[];
  title?: string;
  lang?: Lang;
}
const { items, title, lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
---

{
  items.length > 0 && (
    <section class="mt-12" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="text-2xl">{title ?? t('label.faq')}</h2>
      <div class="mt-5 space-y-3">
        {items.map((item) => (
          <details class="group rounded-2xl border border-[var(--color-sand)] bg-[var(--color-surface)] p-1 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-xl px-4 py-3 font-semibold text-[var(--color-ink)]">
              <span>{item.q}</span>
              <span class="shrink-0 text-[var(--color-primary-600)] transition-transform group-open:rotate-45" aria-hidden="true">
                +
              </span>
            </summary>
            <div class="px-4 pb-4 pt-1 text-[var(--color-ink-soft)]">{item.a}</div>
          </details>
        ))}
      </div>
    </section>
  )
}
