---
import { site } from '@config/site';
import { defaultLang, type Lang } from '@i18n/config';
import { useTranslations } from '@i18n/utils';

/**
 * Franja de confianza con métricas coherentes (PLAN §2.12, §6.1).
 * +15 años de experiencia · +5.000 horas clínicas · nº familias [INPUT].
 */
interface Props {
  lang?: Lang;
}
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const nf = new Intl.NumberFormat(lang === 'en' ? 'en-US' : 'es-ES');

const metrics = [
  { value: `+${site.metrics.yearsExperience}`, label: t('label.years') },
  { value: `+${nf.format(site.metrics.clinicalHours)}`, label: t('label.clinicalHours') },
  ...(site.metrics.families
    ? [{ value: `+${nf.format(site.metrics.families)}`, label: t('label.families') }]
    : [{ value: '[INPUT]', label: t('label.families') }]),
];
---

<section class="bg-[var(--color-primary-700)] text-white">
  <div class="container-page grid grid-cols-3 gap-4 py-8 text-center">
    {
      metrics.map((m) => (
        <div>
          <div class="font-[var(--font-display)] text-2xl font-semibold sm:text-4xl">{m.value}</div>
          <div class="mt-1 text-xs text-[var(--color-primary-100)] sm:text-sm">{m.label}</div>
        </div>
      ))
    }
  </div>
</section>
