# ─────────────────────────────────────────────────────────────────────────────
# Despliegue a Hostinger — PREPARADO PERO DESACTIVADO (PLAN §4, §14).
# Para activarlo:
#   1. Renombrar este archivo a `deploy.yml`.
#   2. Configurar los secrets en el repo (Settings → Secrets and variables → Actions):
#        HOSTINGER_FTP_HOST, HOSTINGER_FTP_USER, HOSTINGER_FTP_PASSWORD, HOSTINGER_FTP_DIR
#   3. Ajustar `SITE_URL` al dominio final antes de conectar DNS.
#   4. Configurar SPF/DKIM/DMARC del dominio (emails de Fase 2).
# ─────────────────────────────────────────────────────────────────────────────
name: Deploy to Hostinger

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: deploy-production
  cancel-in-progress: true

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
      - run: npm ci
      - name: Build
        env:
          SITE_URL: https://constanzaacevedo.es
          PUBLIC_WEB3FORMS_KEY: ${{ secrets.WEB3FORMS_KEY }}
        run: npm run build
      - name: Deploy via FTP
        uses: SamKirkland/FTP-Deploy-Action@v4.3.5
        with:
          server: ${{ secrets.HOSTINGER_FTP_HOST }}
          username: ${{ secrets.HOSTINGER_FTP_USER }}
          password: ${{ secrets.HOSTINGER_FTP_PASSWORD }}
          local-dir: ./dist/
          server-dir: ${{ secrets.HOSTINGER_FTP_DIR }}
